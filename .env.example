# I-Study 환경 설정 (로컬/LAN 서버 모드)
# 이 파일을 복사하여 .env 파일을 만드세요:
#   cp .env.example .env

# PostgreSQL 데이터베이스 (서버 PC 기준)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=istudy

# 서버 바인딩 (0.0.0.0 = LAN의 모든 기기 접속 허용)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# JWT 시크릿 (FastAPI /ws/gaze 와 반드시 동일!)
JWT_SECRET=your-secret-key-change-this

# 클라이언트(데스크톱 앱)가 접속할 서버 주소
# - 서버 PC 본인: http://127.0.0.1:8000
# - LAN 내 다른 기기: http://<서버PC의_사설IP>:8000  (ipconfig 로 IPv4 확인)
API_SERVER_URL=http://127.0.0.1:8000
