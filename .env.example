# I-Study 환경 설정 (서버 PC 용)
# 이 파일을 복사해 .env 를 만들고 비어 있는 DB_PASSWORD, JWT_SECRET 을 채우세요.
#   PowerShell:  Copy-Item .env.example .env
# .env 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않습니다. 비밀번호·키는 .env 에만 적으세요.
# Spring Boot(8000)와 FastAPI AI(8001)가 이 파일 하나를 함께 읽습니다.
# 값에 따옴표를 붙이지 마세요.

# PostgreSQL 데이터베이스 (서버 PC 기준)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# PostgreSQL 설치 때 정한 postgres 비밀번호
DB_PASSWORD=
DB_NAME=istudy

# 서버 바인딩 (0.0.0.0 = LAN의 모든 기기 접속 허용, 127.0.0.1 = 이 PC만)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# JWT 서명 키 — 32자 이상 임의 문자열. 아래 명령으로 만들 수 있습니다.
#   venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 데스크톱 앱(개발 실행 시)이 접속할 서버 주소
# - 서버 PC 본인: http://127.0.0.1:8000
# - LAN 내 다른 기기: http://<서버PC의_사설IP>:8000  (ipconfig 로 IPv4 확인)
API_SERVER_URL=http://127.0.0.1:8000
